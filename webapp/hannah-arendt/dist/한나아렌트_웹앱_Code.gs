      return {questionId:id,question:q.question,source:q.source||'',answer:text_(item.answer,5000)};
    });
    if(submit&&d.questions.some(function(q){return !q.answer;}))fail_('각 토의 질문에 대한 나의 답을 작성해 주세요.');
